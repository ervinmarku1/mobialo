{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:auth",
  "outputDirectory": "dist",
  "functions": {
    "api/paypal/create.mjs": {"maxDuration": 180},
    "api/paypal/capture.mjs": {"maxDuration": 180},
    "api/paypal/webhook.mjs": {"maxDuration": 180}
  },
  "rewrites": [
    {"source": "/", "has": [{"type":"host","value":"admin.mobialo.eu"}], "destination": "/admin.html"},
    {"source": "/admin", "destination": "/admin.html"},
    {"source": "/join", "destination": "/auth.html"},
    {"source": "/sign-in", "destination": "/auth.html"},
    {"source": "/forgot-password", "destination": "/auth.html"},
    {"source": "/update-password", "destination": "/auth.html"},
    {"source": "/account", "destination": "/auth.html"}
  ],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
