# Copy these two values from the API section of the MobiMatter partner portal.
# Save your real credentials ONLY in .env.local (ignored by Git).
MOBIMATTER_MERCHANT_ID=
MOBIMATTER_API_KEY=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Live webhook registration ID, from the same PayPal app as the live credentials.
PAYPAL_WEBHOOK_ID=
# Server-only delivery configuration. Never expose these in browser bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Hosted checkout: closed (default), admin (ADMIN_USER_IDS + 2FA, for testing)
# or public (any signed-in customer; only once the delivery worker is running).
CHECKOUT_MODE=closed
# Existing manually authorized administrators (not approval managers).
ADMIN_USER_IDS=
# Only the owner's UUID should be listed here. Enables the approval workflow.
SUPER_ADMIN_USER_IDS=
ADMIN_MFA_REQUIRED=true
