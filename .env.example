# Template for .env.local (ignored by Git). Put real values ONLY in .env.local; never commit them.
# Vercel has no .env.local: set the same names in Project Settings > Environment Variables.
# WARNING: npm run dev uses whatever this file points at. With PAYPAL_ENV=live it refuses payments, the
# webhook and admin routes unless ALLOW_LOCAL_LIVE=1; with that set it creates real PayPal orders and,
# after a real payment, buys and emails a real eSIM, without the hosted checkout gates. Use
# PAYPAL_ENV=sandbox locally (README, "Local development").

# MobiMatter partner portal > API. Catalog everywhere; eSIM purchases in the delivery worker.
MOBIMATTER_MERCHANT_ID=
MOBIMATTER_API_KEY=

# sandbox: isolated test orders (esim_test_orders), never buys an eSIM. live: real money.
# Hosted checkout on Vercel only runs with live.
PAYPAL_ENV=sandbox
# Sandbox REST app, used when PAYPAL_ENV=sandbox.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Live REST app, used when PAYPAL_ENV=live (checkout, webhook, worker).
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Fallback when the pair for the selected environment is empty.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Live webhook registration ID (not a client ID), from the same PayPal app as the live credentials.
PAYPAL_WEBHOOK_ID=

# Supabase > Project Settings > API. The URL and the sb_publishable_ key are served to browsers for sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only (orders, settings, admin access, worker). Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Resend key for the eSIM delivery email. Optional on Vercel: the cron sweep falls back to the
# Vault secret mobialo_resend_api_key; a value here wins. Required by npm run worker:delivery.
RESEND_API_KEY=

# Shop mode until the first save in the admin Cilësimet (capped at admin during a Supabase outage):
# closed, admin or public. The saved Cilësimet value wins.
CHECKOUT_MODE=closed
# Comma-separated Supabase user UUIDs (not email addresses) with permanent admin access.
ADMIN_USER_IDS=
# The owner's UUID only. Enables the approval workflow and always requires 2FA for that account.
SUPER_ADMIN_USER_IDS=
# true: every admin needs a verified Authenticator factor and a 2FA (aal2) session.
ADMIN_MFA_REQUIRED=true

# Read from the shell environment only, not from this file:
# PORT=3000            port of the local server (npm run dev)
# LOCAL_COUNTRY=IT     simulates the Vercel IP country for /api/locale on the local server
# ALLOW_LOCAL_LIVE=1   lets the local server take LIVE payments and use admin routes (never needed normally)
# BASE_URL=https://www.mobialo.eu   site read by the smoke test (npm run smoke; read-only, no orders)
# CHROME_PATH=...                   Chrome for the smoke test (default: google-chrome, or the Windows install path)
# WORKER_HEALTH_FILE=  heartbeat file of the standalone worker (npm run worker:delivery)
